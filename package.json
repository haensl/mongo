{
  "name": "@haensl/mongo",
  "version": "2.0.1",
  "description": "MongoDB utilities.",
  "main": "index.js",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint '**/*.js'",
    "lint:junit": "ESLINT_USE_FLAT_CONFIG=true eslint --format junit -o test-results/eslint/results.xml '**/*.js'",
    "prepare": "if [ \"${NODE_ENV}\" != 'production' ] && [ -z \"${CI}\" ]; then husky install; fi",
    "test": "jest --runInBand --no-cache --colors --passWithNoTests",
    "test:junit": "jest --runInBand --no-cache --ci --reporters='default' --reporters='jest-junit' --passWithNoTests",
    "tdd": "jest --runInBand --colors --watch"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "package.test"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "jest-junit": {
    "outputDirectory": "test-results/jest",
    "outputName": "results.xml",
    "suitName": "@haensl/mongo unit tests"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/haensl/mongo.git"
  },
  "keywords": [
    "MongoDB",
    "client",
    "errors",
    "cleanup",
    "factory",
    "mongo"
  ],
  "author": {
    "name": "HP Dietz",
    "url": "https://hpdietz.com",
    "twitter": "@h_p_d",
    "email": "h.p.dietz@gmail.com"
  },
  "funding": "https://github.com/sponsors/haensl",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/haensl/mongo/issues"
  },
  "homepage": "https://github.com/haensl/mongo#readme",
  "peerDependencies": {
    "mongodb": "^6.0.0"
  },
  "devDependencies": {
    "@haensl/eslint-config": "^2.0.0",
    "eslint": "^9.31.0",
    "eslint-formatter-junit": "^8.40.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-junit": "^16.0.0",
    "mongodb": "^6.1.0"
  }
}
